# Copier ce fichier en .env (ignoré par Git) puis compléter.

# Port sur la machine hôte
PORT=8080

# Protection du site par identifiant / mot de passe (fortement conseillé dès que
# le site est joignable depuis Internet ; facultatif derrière Tailscale)
IDENTIFIANT=moi
MOT_DE_PASSE=

# Propriétaire du clone (commande « id -u » et « id -g » sur l'hôte Linux)
UID=1000
GID=1000

# Synchronisation GitHub (profil « synchro ») : jeton à granularité fine limité au
# dépôt {{name}}, permission « Contents : Read and write »
GIT_TOKEN=
BRANCHE=main
INTERVALLE=600
GIT_AUTEUR_NOM={{titre}}
GIT_AUTEUR_EMAIL=plateforme@localhost

# Serveur exposé sur Internet uniquement (deploiement/docker-compose.vps.yml)
DOMAINE=
